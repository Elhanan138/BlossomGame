{
  "name": "blossom-game",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch src/server/dev.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx src/server/dev.ts",
    "test": "vitest run",
    "e2e": "node tests/e2e.mjs",
    "db:migrate": "tsx src/server/migrate.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "express": "^4.22.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": "22.x"
  }
}